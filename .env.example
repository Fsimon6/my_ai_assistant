# ============================================================
# 环境变量模板：复制为 .env 后填入真实值
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，**永远不要提交真实密钥**。
# ⚠️ 配置在进程启动时读取一次，改完必须重启后端才会生效。
# ============================================================

# --- 基础 ---
ENVIRONMENT=development
DEBUG=true

# JWT 签名密钥（**必填**，无默认值，缺失时应用启动即失败）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-secret-string

# --- 大模型（OpenAI 兼容接口）---
# 供应商：openai | dashscope | zhipu | ollama | local
LLM_PROVIDER=openai
# 密钥：openai / dashscope / zhipu 必填；ollama / local 可留空
API_KEY=sk-your-api-key-here
# 兼容接口地址（留空则使用该供应商默认地址）
#   dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   zhipu:     https://open.bigmodel.cn/api/paas/v4
#   ollama:    http://localhost:11434/v1
LLM_BASE_URL=
# Chat 模型名
LLM_MODEL=gpt-3.5-turbo

# --- 向量化（与 Chat 模型解耦）---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_DEVICE=cpu

# --- 数据库 ---
DATABASE_URL=sqlite:///./my_ai_assistant.db
# 可选：Redis（留空则不启用）
REDIS_URL=

# --- 向量库（ChromaDB 本地持久化路径）---
VECTOR_DB_PATH=./data/chroma_db
VECTOR_DB_COLLECTION=documents

# --- 跨域允许的前端来源（逗号分隔）---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 日志 ---
LOG_LEVEL=INFO
# 可选：同时写入文件
LOG_FILE=
