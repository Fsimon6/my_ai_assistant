# ============================================================
# 环境变量模板：复制为 .env 后填入真实值
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，**永远不要提交真实密钥**。
# ⚠️ 配置在进程启动时读取一次，改完必须重启后端才会生效。
# ============================================================

# --- 基础 ---
ENVIRONMENT=development
DEBUG=true

# JWT 签名密钥（**必填**，无默认值，缺失时应用启动即失败）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-secret-string

# --- 大模型（OpenAI 兼容接口）---
# 供应商：openai | dashscope | zhipu | ollama | local
LLM_PROVIDER=openai
# 密钥：openai / dashscope / zhipu 必填；ollama / local 可留空
API_KEY=sk-your-api-key-here
# 兼容接口地址（留空则使用该供应商默认地址）
#   dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   zhipu:     https://open.bigmodel.cn/api/paas/v4
#   ollama:    http://localhost:11434/v1
LLM_BASE_URL=
# Chat 模型名
LLM_MODEL=gpt-3.5-turbo
# LLM 请求超时（**秒**，合法范围 1..600；默认 30）。
# 说明：同一 OpenAI 兼容 client 同时用于 chat 与 embedding，因此该超时为 client 级。
LLM_TIMEOUT=30

# --- 向量化（与 Chat 模型解耦）---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_DEVICE=cpu

# --- 数据库 ---
DATABASE_URL=sqlite:///./my_ai_assistant.db
# 可选：Redis（留空则不启用）
REDIS_URL=

# --- 向量库（ChromaDB 本地持久化路径）---
VECTOR_DB_PATH=./data/chroma_db
VECTOR_DB_COLLECTION=documents

# --- 跨域允许的前端来源（逗号分隔）---
# 本副本 Windows 开发前端端口为 5181（Vite 默认 5173 仍保留）。
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5181,http://127.0.0.1:5181

# --- 注册控制 ---
# 是否允许自助注册（true / false）。
# ⚠️ 面向公司/内网部署建议改为 false：关闭后 /api/v1/auth/register 返回 403，
#    账号由管理员预置（或临时置 true 完成建号后再关闭）。
ALLOW_REGISTRATION=true

# --- 日志 ---
LOG_LEVEL=INFO
# 文件日志：默认写入 <项目根>/logs/app.log（自动轮转，5MB × 5）。
# 如需关闭文件日志，取消下面一行注释并留空：
# LOG_FILE=
# 如需更换路径（建议绝对路径，避免受启动目录影响）：
# LOG_FILE=D:/app-logs/ai_assistant.log

# --- 上传大小上限（B2-B：唯一来源，字节）---
# 文档（TXT/MD/DOCX/PDF）与表格（XLSX/XLS/CSV/TSV）共用。
# 默认 10MiB（10485760）；合法范围 1 字节 .. 99MiB（103809024）。
# 上限低于 nginx.conf 的 client_max_body_size(100M)，避免代理先于后端拒绝。
MAX_UPLOAD_SIZE=10485760

# --- 表格解析上限（P-8 大表保护）---
# 超过上限的上传会被明确拒绝（HTTP 413 / FILE_TOO_LARGE），不会静默截断。
# 大内存机器可放宽；改完需重启后端。
# EXCEL_MAX_SHEET_ROWS=200000
# EXCEL_MAX_SHEET_CELLS=2000000
# EXCEL_MAX_TOTAL_CELLS=5000000

# --- 运行时数据目录（F2：留空 = 保持原有默认路径）---
# 上传临时文件目录：留空 -> <系统临时目录>/ai_assistant_uploads
# UPLOAD_TEMP_DIR=D:/ai_assistant_runtime/uploads
# Excel 原件与解析产物根目录：留空 -> <项目根>/data/excel
# EXCEL_DATA_ROOT=D:/ai_assistant_runtime/excel
# 向量库目录（VECTOR_DB_PATH，见上方向量库段）留空/相对路径时按启动目录解析，
# 建议在多目录部署时使用绝对路径。

# --- LLM 生成参数（F1：原先写在 .env 不生效，现已统一）---
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000

# --- API Key 哈希盐（F1）---
# API_KEY_SALT=ai_assistant_salt

# --- 管理员初始化（F1；仅 backend/init_db.py 使用）---
# INIT_ADMIN_PASSWORD=
# INIT_ADMIN_EMAIL=admin@example.com
