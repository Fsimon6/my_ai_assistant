# 统一换行符：仓库内一律存为 LF，避免 Windows/Linux 协作时产生整文件 diff
* text=auto eol=lf

# Windows 脚本保留 CRLF（cmd/PowerShell 对 CRLF 更友好）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本必须为 LF（否则在 Linux 容器里执行会报 bad interpreter）
*.sh text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.db binary
*.sqlite3 binary
*.bin binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary

# 语言统计时排除构建产物与锁文件
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
