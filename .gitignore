# ============================================================
# 运行时数据（**含真实业务数据**：Excel 原件、解析产物、向量库、SQLite）
# 这些内容属于用户数据，禁止入库
# ============================================================
data/
logs/
cache/
uploads/
*.db
*.db-wal
*.db-shm
*.sqlite3
*.xlsx
*.xls
*.xlsm

# ============================================================
# 日志与临时产物
# ============================================================
*.log
*.err
*.pid
*.tmp
*.bak
*.bak_*
coverage/
test-reports/

# ============================================================
# 本地开发残留：根目录下以 `_` 开头的临时脚本/报告（验证脚本、进度文件等）
# 仅作用于仓库根目录，不会误伤 tests/__init__.py 之类的包文件
# ============================================================
/_*
# 根目录下遗留的临时调试脚本与浏览器 E2E 产物
/verify*.py
/diag*.py
/repro*.py
/dbg_log.py
/cleanup_e2e.py
/e2e_*.py
/e2e_*.json
/probe_*
/start_*.ps1
/chars.yaml
/chat.yaml
/login.yaml
*.jsonl

